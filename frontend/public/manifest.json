{
  "name": "TryCode - 在线代码运行器",
  "short_name": "TryCode",
  "description": "支持 30+ 编程语言的在线代码运行器，支持实时协作、AI 助手、包管理",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1e1e1e",
