[Unit]
Description=TryCode Secret Initialization
Documentation=https://github.com/trycode/trycode.run
Before=docker.service
Requires=docker.service
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/bash -c 'test -d /opt/trycode/secrets || mkdir -p /opt/trycode/secrets'
ExecStart=/opt/trycode/scripts/init-secrets.sh
StandardOutput=journal
StandardError=journal
User=root
Group=root

[Install]
WantedBy=multi-user.target